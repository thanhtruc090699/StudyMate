# AI API Configuration
# Copy this file to .env and fill in your actual values

# Base URL of the AI API (e.g., https://api.openai.com/v1 or your custom endpoint)
AiBaseUrl=https://your-ai-api-url.com

# Endpoint for chat completions (e.g., /chat/completions or /api/chat/completions)
AiEndpoint=/api/chat/completions

# Your API key for authentication
ApiKey=your-api-key-here

# Model name to use for analysis (e.g., gpt-3.5-turbo, gpt-4, or custom model)
AiModel=your-model-name
