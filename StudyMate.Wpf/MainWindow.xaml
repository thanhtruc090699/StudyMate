<Window x:Class="StudyMate.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudyMate.Wpf"
        xmlns:views="clr-namespace:StudyMate.Wpf.Views"
        mc:Ignorable="d"
        Title="StudyMate - AI Study Assistant" 
        Height="600" 
        Width="1000"
        WindowState="Maximized">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Folder List -->
        <GroupBox Grid.Column="0" 
                  Header="Folders" 
                  Margin="8,8,4,8"
                  Background="#F5F5F5">
            <ContentControl x:Name="FolderListControl"/>
        </GroupBox>

        <!-- Right Panel: File List -->
        <GroupBox Grid.Column="1" 
                  Header="Files" 
                  Margin="4,8,8,8"
                  Background="White">
            <ContentControl x:Name="FileListControl"/>
        </GroupBox>
    </Grid>
</Window>
