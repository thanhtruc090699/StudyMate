<UserControl
    x:Class="StudyMate.Wpf.Views.FileDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="820"
    d:DesignWidth="620"
    Background="{StaticResource BackgroundColor}"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!--  Close button style  -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CloseButton}"/>

        <!--  Tab item style  -->
        <Style x:Key="ModernTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource ModernTabItem}"/>

        <!--  Quiz option style  -->
        <Style x:Key="QuizOptionStyle" TargetType="RadioButton" BasedOn="{StaticResource QuizOptionStyle}"/>

    </UserControl.Resources>

    <Grid>

        <!--  State: no file selected  -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <StackPanel.Style>
                <Style TargetType="StackPanel">

                    <Setter Property="Visibility" Value="Collapsed" />

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding SelectedFile}" Value="{x:Null}">

                            <Setter Property="Visibility" Value="Visible" />

                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </StackPanel.Style>

            <Border
                Width="82"
                Height="82"
                Background="{StaticResource PrimaryLightColor}"
                CornerRadius="18">

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="21"
                    FontWeight="Bold"
                    Foreground="{StaticResource PrimaryColor}"
                    Text="PDF" />

            </Border>

            <TextBlock
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextDarkColor}"
                Text="Select a PDF file" />

            <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                FontSize="14"
                Foreground="#7A808C"
                Text="Choose a file to view its summary and quiz." />

        </StackPanel>

        <!--  Main content  -->
        <Grid>

            <Grid.Style>
                <Style TargetType="Grid">

                    <Setter Property="Visibility" Value="Visible" />

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding SelectedFile}" Value="{x:Null}">

                            <Setter Property="Visibility" Value="Collapsed" />

                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Grid Grid.Row="0" Margin="28,28,28,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  PDF icon  -->
                <Border
                    Grid.Column="0"
                    Width="46"
                    Height="54"
                    Background="{StaticResource PDFIconBackground}"
                    BorderBrush="{StaticResource PDFBorderColor}"
                    BorderThickness="1"
                    CornerRadius="7">

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="18"
                            Foreground="{StaticResource PDFIconForeground}"
                            Text="⌁" />

                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="{StaticResource PDFIconForeground}"
                            Text="PDF" />

                    </StackPanel>

                </Border>

                <!--  File information  -->
                <StackPanel
                    Grid.Column="1"
                    Margin="14,0,16,0"
                    VerticalAlignment="Center">

                    <TextBlock
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryColor}"
                        Text="{Binding SelectedFile.OriginalFileName}"
                        TextTrimming="CharacterEllipsis" />

                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">

                        <TextBlock
                            FontSize="13"
                            Foreground="{StaticResource TextSecondaryColor}"
                            Text="{Binding SelectedFile.FileSizeDisplay}" />

                        <TextBlock
                            Margin="8,0"
                            Foreground="#A1A5AE"
                            Text="•" />

                        <TextBlock
                            FontSize="13"
                            Foreground="{StaticResource TextSecondaryColor}"
                            Text="PDF Document" />

                    </StackPanel>

                </StackPanel>

                <!--  Close  -->
                <Button
                    Grid.Column="2"
                    Command="{Binding CloseCommand}"
                    Content="×"
                    Style="{StaticResource CloseButtonStyle}" />

            </Grid>

            <!--  Tabs  -->
            <TabControl
                Grid.Row="1"
                Margin="28,22,28,28"
                Background="Transparent"
                BorderThickness="0"
                SelectedIndex="{Binding SelectedTabIndex}">

                <TabControl.Resources>

                    <Style TargetType="TabPanel">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                    </Style>

                </TabControl.Resources>

                <!--  Summary  -->
                <TabItem Header="Summary" Style="{StaticResource ModernTabItemStyle}">

                    <ScrollViewer
                        Padding="0,18,0,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">

                        <Border
                            Padding="24"
                            Background="{StaticResource BackgroundColor}"
                            BorderBrush="{StaticResource TabBorderColor}"
                            BorderThickness="1"
                            CornerRadius="10">

                            <StackPanel>

                                <TextBlock
                                    FontSize="21"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextPrimaryColor}"
                                    Text="Summary" />

                                <TextBlock
                                    Margin="0,20,0,0"
                                    FontSize="15"
                                    Foreground="{StaticResource TextColorMedium}"
                                    LineHeight="26"
                                    Text="{Binding Summary}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="0,28,0,0"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextPrimaryColor}"
                                    Text="Key Points" />

                                <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding KeyPoints}">

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>

                                            <Grid Margin="0,0,0,14">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Top"
                                                    FontSize="18"
                                                    Foreground="{StaticResource TextDarkColor}"
                                                    Text="•" />

                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="15"
                                                    Foreground="{StaticResource TextColorMedium}"
                                                    LineHeight="24"
                                                    Text="{Binding}"
                                                    TextWrapping="Wrap" />

                                            </Grid>

                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </StackPanel>

                        </Border>

                    </ScrollViewer>

                </TabItem>

                <!--  Quiz  -->
                <TabItem Header="Quiz" Style="{StaticResource ModernTabItemStyle}">

                    <ScrollViewer
                        Padding="0,18,0,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">

                        <Border
                            Padding="24"
                            Background="{StaticResource BackgroundColor}"
                            BorderBrush="{StaticResource TabBorderColor}"
                            BorderThickness="1"
                            CornerRadius="10">

                            <StackPanel>

                                <TextBlock
                                    FontSize="13"
                                    Foreground="#747B88"
                                    Text="{Binding QuizProgressText}" />

                                <TextBlock
                                    Margin="0,12,0,20"
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryColor}"
                                    Text="{Binding CurrentQuestion.QuestionText}"
                                    TextWrapping="Wrap" />

                                <ItemsControl ItemsSource="{Binding CurrentQuestion.Options}">

                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Focusable" Value="False" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>

                                            <RadioButton
                                                Command="{Binding DataContext.CurrentQuestion.SelectOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding Text}"
                                                GroupName="QuizOptions"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource QuizOptionStyle}" />

                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                                <!--  Result message  -->
                                <Border
                                    Margin="0,16,0,0"
                                    Padding="12"
                                    CornerRadius="8">

                                    <Border.Style>
                                        <Style TargetType="Border">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                            <Setter Property="Background" Value="{StaticResource SuccessLightColor}" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding CurrentQuestion.IsSubmitted}" Value="True">

                                                    <Setter Property="Visibility" Value="Visible" />

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding CurrentQuestion.IsCorrect}" Value="False">

                                                    <Setter Property="Background" Value="#FFF1F1" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>
                                    </Border.Style>

                                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextDarkColor}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource ResultTextConverter}">
                                                <Binding Path="CurrentQuestion.IsSubmitted" />
                                                <Binding Path="CurrentQuestion.IsCorrect" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                </Border>

                                <!--  Explanation  -->
                                <Border
                                    Margin="0,12,0,0"
                                    Padding="14"
                                    Background="{StaticResource ExplanationBackground}"
                                    BorderBrush="{StaticResource ExplanationBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{Binding CurrentQuestion.IsSubmitted, Converter={StaticResource BoolToVisibilityConverter}}">

                                    <StackPanel>

                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource ExplanationText}"
                                            Text="Explanation" />

                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="13"
                                            Foreground="{StaticResource TextColorLight}"
                                            Text="{Binding CurrentQuestion.Explanation}"
                                            TextWrapping="Wrap" />

                                    </StackPanel>

                                </Border>

                                <!--  Check Answer button  -->
                                <Button
                                    Width="130"
                                    Height="40"
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding CheckAnswerCommand}"
                                    Content="Check Answer"
                                    Visibility="{Binding CurrentQuestion.IsSubmitted, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverted}" />

                                <!--  Quiz buttons  -->
                                <Grid Margin="0,24,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        Grid.Column="0"
                                        Width="100"
                                        Height="38"
                                        Margin="0,0,16,0"
                                        Command="{Binding PreviousQuestionCommand}"
                                        Content="Previous" />

                                    <Button
                                        Grid.Column="2"
                                        Width="100"
                                        Height="38"
                                        Margin="16,0,0,0"
                                        Background="{StaticResource PrimaryColor}"
                                        BorderThickness="0"
                                        Command="{Binding NextQuestionCommand}"
                                        Content="Next"
                                        Foreground="{StaticResource TextOnPrimaryColor}" />

                                </Grid>

                            </StackPanel>

                        </Border>

                    </ScrollViewer>

                </TabItem>

            </TabControl>

        </Grid>

        <!--  Loading overlay  -->
        <Border
            Background="{StaticResource LoadingOverlayColor}"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <ProgressBar
                    Width="190"
                    Height="5"
                    IsIndeterminate="True" />

                <TextBlock
                    Margin="0,12,0,0"
                    FontSize="14"
                    Foreground="{StaticResource LoadingTextColor}"
                    Text="Generating study material..." />

            </StackPanel>

        </Border>

    </Grid>

</UserControl>
