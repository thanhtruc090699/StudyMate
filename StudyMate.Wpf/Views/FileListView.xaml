<UserControl
    x:Class="StudyMate.Wpf.Views.FileListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="720"
    d:DesignWidth="440"
    Background="{StaticResource BackgroundColor}"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!--  Upload button style  -->
        <Style x:Key="UploadButtonStyle" TargetType="Button" BasedOn="{StaticResource UploadButton}"/>

        <!--  Icon button style  -->
        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButton}"/>

    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundColor}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  When no folder is selected  -->
        <StackPanel
            Grid.RowSpan="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel.Style>
                <Style TargetType="StackPanel">

                    <Setter Property="Visibility" Value="Collapsed" />

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding SelectedFolder}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </StackPanel.Style>

            <Border
                Width="80"
                Height="80"
                Background="{StaticResource PrimaryLightColor}"
                CornerRadius="18">

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="36"
                    Text="📁" />

            </Border>

            <TextBlock
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextDarkColor}"
                Text="Select a folder" />

            <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                FontSize="14"
                Foreground="{StaticResource TextSecondaryColor}"
                Text="Choose a folder on the left to view its PDF files." />

        </StackPanel>

        <!--  Header  -->
        <StackPanel Grid.Row="0" Margin="34,34,34,0">

            <StackPanel.Style>
                <Style TargetType="StackPanel">

                    <Setter Property="Visibility" Value="Visible" />

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding SelectedFolder}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </StackPanel.Style>

            <TextBlock
                FontSize="26"
                FontWeight="Bold"
                Foreground="{StaticResource TextPrimaryColor}"
                Text="{Binding SelectedFolder.Name}"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                Margin="0,5,0,0"
                FontSize="14"
                Foreground="{StaticResource TextSecondaryColor}">

                <Run Text="{Binding Files.Count, Mode=OneWay}" />
                <Run Text=" files" />

            </TextBlock>

        </StackPanel>

        <!--  Upload button  -->
        <Button
            Grid.Row="1"
            Height="48"
            Margin="34,20,34,20"
            HorizontalAlignment="Stretch"
            Command="{Binding UploadFileCommand}">

            <Button.Style>
                <Style BasedOn="{StaticResource UploadButtonStyle}" TargetType="Button">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFolder}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                <TextBlock
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="21"
                    Text="⇧" />

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="15"
                    Text="Upload File" />

            </StackPanel>

        </Button>

        <!--  Messages  -->
        <StackPanel
            Grid.Row="2"
            Margin="34,0,34,8"
            HorizontalAlignment="Stretch">

            <Border
                Margin="0,0,0,8"
                Padding="11"
                Background="{StaticResource ErrorLightColor}"
                CornerRadius="7"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}">

                <TextBlock
                    Foreground="{StaticResource ErrorColor}"
                    Text="{Binding ErrorMessage}"
                    TextWrapping="Wrap" />

            </Border>

            <Border
                Margin="0,0,0,8"
                Padding="11"
                Background="{StaticResource SuccessLightColor}"
                CornerRadius="7"
                Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}">

                <TextBlock
                    Foreground="{StaticResource SuccessColor}"
                    Text="{Binding SuccessMessage}"
                    TextWrapping="Wrap" />

            </Border>

        </StackPanel>

        <!--  File list area  -->
        <Grid
            Grid.Row="3"
            Margin="24,4,24,24"
            HorizontalAlignment="Stretch">

            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFolder}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <ListBox
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Files}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                SelectionChanged="FileList_SelectionChanged">

                <ListBox.ItemContainerStyle>

                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource FileListBoxItem}"/>

                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <Grid>



                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>

                            <!--  PDF icon  -->
                            <Border
                                Grid.Column="0"
                                Width="42"
                                Height="50"
                                Background="{StaticResource PDFIconBackground}"
                                BorderBrush="{StaticResource PDFBorderColor}"
                                BorderThickness="1"
                                CornerRadius="7">

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="18"
                                        Foreground="{StaticResource PDFIconForeground}"
                                        Text="⌁" />

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="9"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource PDFIconForeground}"
                                        Text="PDF" />

                                </StackPanel>

                            </Border>

                            <!--  File information  -->
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,8,0"
                                VerticalAlignment="Center">

                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextColorDark}"
                                    Text="{Binding OriginalFileName}"
                                    TextTrimming="CharacterEllipsis" />

                                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">

                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryColor}">

                                        <Run Text="{Binding FileSizeBytes, StringFormat={}{0:F0}}" />
                                        <Run Text=" bytes" />

                                    </TextBlock>

                                    <TextBlock
                                        Margin="7,0"
                                        Foreground="{StaticResource TextMutedColor}"
                                        Text="•" />

                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryColor}"
                                        Text="{Binding UploadedAt, StringFormat={}{0:dd MMM yyyy}}" />

                                </StackPanel>

                            </StackPanel>

                            <!--  Three-dot menu  -->
                            <Button
                                Grid.Column="2"
                                Width="34"
                                Height="34"
                                VerticalAlignment="Center"
                                Content="⋮"
                                PreviewMouseLeftButtonDown="MoreButton_PreviewMouseLeftButtonDown"
                                Style="{StaticResource IconButtonStyle}"
                                Tag="{Binding}">

                                <Button.ContextMenu>

                                    <ContextMenu>

                                        <MenuItem
                                            Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            Foreground="{StaticResource ErrorColor}"
                                            Header="Delete" />

                                    </ContextMenu>

                                </Button.ContextMenu>

                            </Button>

                        </Grid>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

            <!--  Folder selected but no file  -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <StackPanel.Style>
                    <Style TargetType="StackPanel">

                        <Setter Property="Visibility" Value="Collapsed" />

                        <Style.Triggers>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>

                                    <Condition Binding="{Binding SelectedFolder}" Value="{x:Null}" />

                                    <Condition Binding="{Binding Files.Count}" Value="0" />

                                </MultiDataTrigger.Conditions>

                                <Setter Property="Visibility" Value="Visible" />

                            </MultiDataTrigger>

                        </Style.Triggers>

                    </Style>
                </StackPanel.Style>

                <Border
                    Width="72"
                    Height="72"
                    Background="#F4F0FF"
                    CornerRadius="36">

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryColor}"
                        Text="PDF" />

                </Border>

                <TextBlock
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="#292C35"
                    Text="No files yet" />

                <TextBlock
                    Margin="0,7,0,0"
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Foreground="{StaticResource TextSecondaryColor}"
                    Text="Upload a PDF file to create a summary and quiz." />

            </StackPanel>

        </Grid>

        <!--  Loading overlay  -->
        <Border
            Grid.RowSpan="4"
            Background="{StaticResource LoadingOverlayColor}"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <ProgressBar
                    Width="180"
                    Height="5"
                    IsIndeterminate="True" />

                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{StaticResource LoadingTextColor}"
                    Text="Loading..." />

            </StackPanel>

        </Border>

    </Grid>

</UserControl>
