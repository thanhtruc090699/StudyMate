<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ============================================ -->
    <!-- Primary Colors - Purple Theme (#6C4CF1)      -->
    <!-- ============================================ -->
    <SolidColorBrush x:Key="PrimaryColor" Color="#6C4CF1"/>
    <SolidColorBrush x:Key="PrimaryHoverColor" Color="#7A55F5"/>
    <SolidColorBrush x:Key="PrimaryLightColor" Color="#EEE9FF"/>
    <SolidColorBrush x:Key="PrimaryLighterColor" Color="#F7F4FF"/>
    <SolidColorBrush x:Key="PrimaryLightestColor" Color="#FAF8FF"/>
    <SolidColorBrush x:Key="PrimaryBorderColor" Color="#BCAEFF"/>
    <SolidColorBrush x:Key="PrimaryDarkColor" Color="#5E3FD6"/>
    
    <!-- ============================================ -->
    <!-- Background Colors                            -->
    <!-- ============================================ -->
    <SolidColorBrush x:Key="BackgroundColor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceColor" Color="#F8F9FC"/>
    <SolidColorBrush x:Key="CardBackgroundColor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BackgroundSecondaryColor" Color="#F5F5F8"/>
    
    <!-- ============================================ -->
    <!-- Text Colors                                  -->
    <!-- ============================================ -->
    <SolidColorBrush x:Key="TextPrimaryColor" Color="#171A21"/>
    <SolidColorBrush x:Key="TextSecondaryColor" Color="#737988"/>
    <SolidColorBrush x:Key="TextMutedColor" Color="#9A9EAA"/>
    <SolidColorBrush x:Key="TextOnPrimaryColor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextDarkColor" Color="#20242C"/>
    <SolidColorBrush x:Key="TextColor" Color="#343842"/>
    <SolidColorBrush x:Key="TextColorDark" Color="#25272D"/>
    <SolidColorBrush x:Key="TextColorMedium" Color="#30343C"/>
    <SolidColorBrush x:Key="TextColorLight" Color="#444952"/>
    
    <!-- ============================================ -->
    <!-- Status Colors                                -->
    <!-- ============================================ -->
    <SolidColorBrush x:Key="SuccessColor" Color="#218739"/>
    <SolidColorBrush x:Key="SuccessLightColor" Color="#EDF8F0"/>
    <SolidColorBrush x:Key="ErrorColor" Color="#D93025"/>
    <SolidColorBrush x:Key="ErrorLightColor" Color="#FFF0F0"/>
    <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarningLightColor" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="InfoColor" Color="#3B82F6"/>
    <SolidColorBrush x:Key="InfoLightColor" Color="#DBEAFE"/>
    
    <!-- ============================================ -->
    <!-- Border & Divider Colors                      -->
    <!-- ============================================ -->
    <SolidColorBrush x:Key="BorderColor" Color="#E1E4EA"/>
    <SolidColorBrush x:Key="BorderLightColor" Color="#E7E9EF"/>
    <SolidColorBrush x:Key="BorderLighterColor" Color="#E3E6EC"/>
    <SolidColorBrush x:Key="DividerColor" Color="#E8E8F0"/>
    <SolidColorBrush x:Key="PDFBorderColor" Color="#F4D5D5"/>
    <SolidColorBrush x:Key="QuizBorderColor" Color="#C3B2FF"/>
    <SolidColorBrush x:Key="TabBorderColor" Color="#E4E7EC"/>
    
    <!-- ============================================ -->
    <!-- Interactive State Colors                     -->
    <!-- ============================================ -->
    <SolidColorBrush x:Key="DisabledColor" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="DisabledBackgroundColor" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="SelectionColor" Color="#6C4CF1"/>
    <SolidColorBrush x:Key="FocusColor" Color="#5A3FD4"/>
    <SolidColorBrush x:Key="IconColor" Color="#687080"/>
    <SolidColorBrush x:Key="IconArrowColor" Color="#90949D"/>
    
    <!-- ============================================ -->
    <!-- Special UI Element Colors                    -->
    <!-- ============================================ -->
    <SolidColorBrush x:Key="PDFIconBackground" Color="#FFF3F3"/>
    <SolidColorBrush x:Key="PDFIconForeground" Color="#E53935"/>
    <SolidColorBrush x:Key="FolderIconBackground" Color="#F1ECFF"/>
    <SolidColorBrush x:Key="FolderIconBackgroundSelected" Color="#EEE9FF"/>
    <SolidColorBrush x:Key="ExplanationBackground" Color="#F8F5FF"/>
    <SolidColorBrush x:Key="ExplanationBorder" Color="#DDD3FF"/>
    <SolidColorBrush x:Key="ExplanationText" Color="#5E3FD6"/>
    <SolidColorBrush x:Key="LoadingOverlayColor" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="LoadingTextColor" Color="#606674"/>
    <SolidColorBrush x:Key="FolderFormBackground" Color="#F2EEFF"/>
    <SolidColorBrush x:Key="FolderFormBorder" Color="#CABDFF"/>
    <SolidColorBrush x:Key="HeaderIconBackground" Color="#EEE9FF"/>
    
</ResourceDictionary>
